# ─── Ollama ──────────────────────────────────────────────────────────────────

# Ollama runs natively on the host machine, not inside Docker.

# The backend Docker container reaches it through host.docker.internal.

OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models — pull once on the host:

# ollama pull qwen2.5:7b

# ollama pull bge-m3

LLM_MODEL=qwen2.5:7b

# Optional lighter model used only for short auto-titles.

# Example: TITLE_MODEL=qwen2.5:1.5b

TITLE_MODEL=
EMBED_MODEL=bge-m3

# ─── Vector store + persistence ──────────────────────────────────────────────

# These paths are inside the Docker volume.

CHROMA_PATH=/app/data/chroma
SQLITE_PATH=/app/data/rag.db
COLLECTION_NAME=rag_knowledge_base

# ─── Generation / context ────────────────────────────────────────────────────

CONTEXT_WINDOW=8192
NUM_OUTPUT=1024
REQUEST_TIMEOUT=600

# ─── Chunking ────────────────────────────────────────────────────────────────

CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Retrieval + hybrid search ───────────────────────────────────────────────

RETRIEVE_TOP_K=6
RETRIEVE_CANDIDATES=20

# Hybrid retrieval combines dense vector search + BM25 lexical search.

HYBRID_ENABLED=true

# Minimum BM25 score for a lexical-only hit to be trusted.

# Increase this if unrelated documents appear through weak keyword matches.

MIN_BM25_SCORE=1.5

# Minimum dense similarity required for a chunk to be considered relevant.

RELEVANCE_CUTOFF=0.35

# ─── Source display ──────────────────────────────────────────────────────────

# Controls displayed source cards only.

# SOURCE_DISPLAY_TOP_K=1 is recommended for demos because it favors precision.

SOURCE_DISPLAY_TOP_K=1

# Legacy/source-display controls kept for compatibility.

SOURCE_MIN_SCORE=0.40
SOURCE_REL_GAP=0.10
SOURCE_MAX=4

# Rerank score threshold for secondary displayed source cards.

SOURCE_DISPLAY_MIN_RERANK=0.0

# Post-answer grounding check.

# If a non-strict answer has too little overlap with retrieved context,

# it is treated as a general answer and no document source is shown.

GROUNDING_MIN_OVERLAP=0.18

# ─── Query rewriting ─────────────────────────────────────────────────────────

# Rewrites follow-up questions into standalone retrieval queries.

# Example: "ce projet", "بهذا المركب", etc.

QUERY_REWRITE_ENABLED=true

# ─── Strict RAG ──────────────────────────────────────────────────────────────

# false means strict mode is controlled from the UI with "Documents uniquement".

# true means the backend is strict by default.

STRICT_RAG=false

# ─── Reranker ────────────────────────────────────────────────────────────────

# Reranker improves retrieval quality but is slower and downloads a model.

RERANK_ENABLED=false
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# ─── Recommended serious evaluation config ──────────────────────────────────

# For better quality but slower responses, you can use:

#

# HYBRID_ENABLED=true

# RERANK_ENABLED=true

# RETRIEVE_CANDIDATES=20

# RETRIEVE_TOP_K=6

# RERANK_TOP_N=5

# RELEVANCE_CUTOFF=0.25

# MIN_BM25_SCORE=1.5

# STRICT_RAG=true

# SOURCE_DISPLAY_TOP_K=1

# SOURCE_DISPLAY_MIN_RERANK=0.3

# ─── Conversation memory ─────────────────────────────────────────────────────

MEMORY_TOKEN_LIMIT=3000

# ─── Auth / RBAC ─────────────────────────────────────────────────────────────

# Change JWT_SECRET before any real deployment.

JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_HOURS=12

# Default admin account created on first startup.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=[admin@local.host](mailto:admin@local.host)

# ─── Frontend / CORS ─────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Uploads ─────────────────────────────────────────────────────────────────

# Max upload size in MB. 0 disables the check.

MAX_UPLOAD_MB=25
