# Copy this file to `.env` and adjust if needed:  cp .env.example .env
# (.env is gitignored; docker-compose reads it automatically.)
# Tuned for: RTX 5050 Laptop (8 GB VRAM) + 16 GB RAM.

# ─── Ollama (runs NATIVELY on the host, not in Docker) ────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models — pull once on the host:
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
LLM_MODEL=qwen2.5:7b          # qwen2.5:3b if VRAM gets tight
EMBED_MODEL=bge-m3

# ─── Vector store + persistence (inside the rag_data volume) ─────────────────
CHROMA_PATH=/app/data/chroma
SQLITE_PATH=/app/data/rag.db
COLLECTION_NAME=rag_knowledge_base

# ─── Generation / context ────────────────────────────────────────────────────
CONTEXT_WINDOW=8192
NUM_OUTPUT=1024
REQUEST_TIMEOUT=600

# ─── Chunking ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Retrieval + reranking ───────────────────────────────────────────────────
RETRIEVE_TOP_K=10
RERANK_TOP_N=4
RERANK_ENABLED=true           # false = faster, lower quality. First run downloads ~2.2 GB.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu             # keep VRAM free for the LLM

# ─── Conversation memory ─────────────────────────────────────────────────────
MEMORY_TOKEN_LIMIT=3000
