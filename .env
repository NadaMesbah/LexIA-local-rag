# ─── Ollama (runs NATIVELY on the host, not in Docker) ────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models — pull once on the host:
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
LLM_MODEL=qwen2.5:7b          # qwen2.5:3b if VRAM gets tight
# Optional lighter model used only for short auto-titles (falls back to LLM_MODEL).
# e.g. TITLE_MODEL=qwen2.5:1.5b
TITLE_MODEL=
EMBED_MODEL=bge-m3
# ─── Vector store + persistence (inside the rag_data volume) ─────────────────
CHROMA_PATH=/app/data/chroma
SQLITE_PATH=/app/data/rag.db
COLLECTION_NAME=rag_knowledge_base

# ─── Generation / context ────────────────────────────────────────────────────
CONTEXT_WINDOW=8192
NUM_OUTPUT=1024
REQUEST_TIMEOUT=600

# ─── Chunking ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Retrieval + reranking ───────────────────────────────────────────────────
RETRIEVE_TOP_K=6
# Wider candidate pool fetched from each retriever before fusion/rerank.
RETRIEVE_CANDIDATES=20
# Hybrid retrieval: dense vectors + lexical BM25 (catches exact terms/names/codes).
HYBRID_ENABLED=true
# Minimum BM25 score for a lexical-only hit to be trusted on its own (0 = keep
# any hit). Stops common words from surfacing unrelated documents; a hit below
# this is kept only if its dense cosine also passes RELEVANCE_CUTOFF.
MIN_BM25_SCORE=1.5
RERANK_TOP_N=5
RERANK_ENABLED=false          # true = higher quality, slower (CPU, one-time ~2.2 GB download)
# Optional: drop reranked candidates below this cross-encoder score (0 = off).
RERANK_MIN_SCORE=0.0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu             # keep VRAM free for the LLM
# Strict RAG: answer ONLY from documents (never general chat). Off keeps small talk.
STRICT_RAG=false
# Min cosine similarity to treat a chunk as relevant. Lower = better recall
# (more answers grounded on docs + sources); raise toward 0.5 if off-topic
# chunks leak in. With the reranker OFF, ~0.35 works well for bge-m3.
RELEVANCE_CUTOFF=0.35
# Which retrieved chunks are SHOWN as sources (display only; does not affect the
# answer). Show matches near the best score and above a floor, capped in number.
# Raise SOURCE_MIN_SCORE / lower SOURCE_REL_GAP if unrelated sources still appear.
SOURCE_MIN_SCORE=0.40
SOURCE_REL_GAP=0.10
SOURCE_MAX=4

# ─── Recommended config for SERIOUS evaluation runs ──────────────────────────
# Copy these over the values above when benchmarking retrieval quality (slower,
# higher quality). Reranker downloads ~2.2 GB once and runs on CPU.
#   HYBRID_ENABLED=true
#   RERANK_ENABLED=true
#   RETRIEVE_CANDIDATES=20
#   RETRIEVE_TOP_K=6
#   RERANK_TOP_N=5
#   RELEVANCE_CUTOFF=0.25
#   MIN_BM25_SCORE=1.5
#   STRICT_RAG=true
# Then: python eval/retrieval_eval.py --dataset eval/dataset.example.json   (fast, no LLM)
#       python eval/ragas_eval.py --limit 5                                  (small RAGAS first)

# ─── Conversation memory ─────────────────────────────────────────────────────
MEMORY_TOKEN_LIMIT=3000


# ─── Auth / RBAC ─────────────────────────────────────────────────────────────
# CHANGE JWT_SECRET before any real deployment (any long random string).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_HOURS=12
# Seeded on first startup. Pre-auth sessions/documents are adopted by this admin.
# ADMIN_EMAIL is the address the admin uses to sign in (login is email-based).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@local.host
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000
# Reject uploads larger than this (MB). 0 disables the check.
MAX_UPLOAD_MB=25