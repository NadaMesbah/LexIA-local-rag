# ─── Ollama (runs NATIVELY on the host, not in Docker) ────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models — pull once on the host:
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
LLM_MODEL=qwen2.5:7b          # qwen2.5:3b if VRAM gets tight
# Optional lighter model used only for short auto-titles (falls back to LLM_MODEL).
# e.g. TITLE_MODEL=qwen2.5:1.5b
TITLE_MODEL=
EMBED_MODEL=bge-m3
# ─── Vector store + persistence (inside the rag_data volume) ─────────────────
CHROMA_PATH=/app/data/chroma
SQLITE_PATH=/app/data/rag.db
COLLECTION_NAME=rag_knowledge_base

# ─── Generation / context ────────────────────────────────────────────────────
CONTEXT_WINDOW=8192
NUM_OUTPUT=1024
REQUEST_TIMEOUT=600

# ─── Chunking ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Retrieval + reranking ───────────────────────────────────────────────────
RETRIEVE_TOP_K=5
RERANK_TOP_N=4
RERANK_ENABLED=false          # true = higher quality, slower (CPU, one-time ~2.2 GB download)
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu             # keep VRAM free for the LLM

# ─── Conversation memory ─────────────────────────────────────────────────────
MEMORY_TOKEN_LIMIT=3000


# ─── Auth / RBAC ─────────────────────────────────────────────────────────────
# CHANGE JWT_SECRET before any real deployment (any long random string).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_HOURS=12
# Seeded on first startup. Pre-auth sessions/documents are adopted by this admin.
# ADMIN_EMAIL is the address the admin uses to sign in (login is email-based).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@local.host
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000
# Reject uploads larger than this (MB). 0 disables the check.
MAX_UPLOAD_MB=25