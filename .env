# ─── Milvus ───────────────────────────────────────────────────────────────────
MILVUS_URI=http://localhost:19530
COLLECTION_NAME=rag_knowledge_base

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# LLM model — options: mistral, llama3, llama3.1, qwen2.5, gemma2
LLM_MODEL=qwen2.5

# Embedding model — nomic-embed-text gives 768 dims, all-minilm gives 384
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64